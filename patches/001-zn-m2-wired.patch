diff --git a/target/linux/qualcommax/dts/ipq6000-m2.dts b/target/linux/qualcommax/dts/ipq6000-m2.dts
index 4264864..8061d51 100644
--- a/target/linux/qualcommax/dts/ipq6000-m2.dts
+++ b/target/linux/qualcommax/dts/ipq6000-m2.dts
@@ -57,7 +57,22 @@
 };
 
 &wifi {
-	status = "okay";
+	status = "disabled";
 	qcom,ath11k-fw-memory-mode = <1>;
 	qcom,ath11k-calibration-variant = "ZN-M2";
-};
\ No newline at end of file
+};
+/* Wired-only: no WLAN remote processor, USB or external PCIe devices. */
+&q6v5_wcss { status = "disabled"; };
+&usb3 { status = "disabled"; };
+&qusb_phy_0 { status = "disabled"; };
+&ssphy_0 { status = "disabled"; };
+&pcie_phy { status = "disabled"; };
+/* Previously validated wired-only layout: reclaim unused NSS reservation. */
+/delete-node/ &nss_region;
+&cpu_opp_table {
+    opp-1320000000 { status = "disabled"; };
+    opp-1440000000 { status = "disabled"; };
+    opp-1512000000 { status = "disabled"; };
+    opp-1608000000 { status = "disabled"; };
+    opp-1800000000 { status = "disabled"; };
+};
