#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
# Run after package defaults. Credentials and external services are opt-in.
[ ! -e /etc/znm2-wired/configured ] || exit 0
uci -q batch <<'EOF'
set system.@system[0].hostname='ZN-M2-Wired'
set system.@system[0].timezone='CST-8'
set system.@system[0].zonename='Asia/Shanghai'
set system.@system[0].log_size='64'
set system.@system[0].zram_size_mb='64'
set system.@system[0].zram_comp_algo='lzo'
set network.lan.ipaddr='192.168.8.1'
set network.lan.netmask='255.255.255.0'
set network.wan.proto='dhcp'
delete network.wan.ipaddr
delete network.wan.netmask
delete network.wan.gateway
delete network.wan.dns
set dhcp.@dnsmasq[0].cachesize='1000'
set firewall.@defaults[0].flow_offloading='0'
set firewall.@defaults[0].flow_offloading_hw='0'
set firewall.@defaults[0].fullcone='0'
set firewall.znm2_tailscale=zone
set firewall.znm2_tailscale.name='tailscale'
add_list firewall.znm2_tailscale.device='tailscale0'
set firewall.znm2_tailscale.input='ACCEPT'
set firewall.znm2_tailscale.output='ACCEPT'
set firewall.znm2_tailscale.forward='REJECT'
set uhttpd.main.max_requests='3'
commit system
commit network
commit dhcp
commit firewall
commit uhttpd
EOF
# The pinned upstream also enables fullcone per zone. Clear those overrides.
for zone in $(uci -q show firewall | sed -n 's/^\(firewall\.[^.]*\)=zone$/\1/p'); do
    uci -q set "$zone.fullcone=0"
done
uci -q commit firewall
for service in passwall nginx acme tailscale; do
    [ ! -x /etc/init.d/$service ] || /etc/init.d/$service disable
done
mkdir -p /etc/znm2-wired
touch /etc/znm2-wired/configured
exit 0
