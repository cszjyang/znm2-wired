#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: GPL-2.0-only
START=91
USE_PROCD=1
start_service() {
    local enabled listen port
    config_load znm2_socks
    config_get_bool enabled main enabled 0
    [ "$enabled" = 1 ] || return 0
    config_get listen main listen 127.0.0.1
    config_get port main port 1080
    case "$port" in ''|*[!0-9]*) return 1;; esac
    [ "$port" -gt 0 ] && [ "$port" -le 65535 ] || return 1
    procd_open_instance
    procd_set_param command /usr/bin/microsocks -i "$listen" -p "$port"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}
